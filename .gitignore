.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Data folders (keep structure, ignore contents due to size)

# Raw data
data/raw/**
!data/raw/**/.gitkeep

# Checkpoints
data/_checkpoints/**
!data/_checkpoints/**/.gitkeep

# Backwards-compatibility (if any older checkpoint folders still exist)
data/checkpoints/**
!data/checkpoints/**/.gitkeep
data/raw/checkpoints/**
!data/raw/checkpoints/**/.gitkeep

# Licence flag logs (only created when unexpected licences appear)
data/raw/licence_flags/**
!data/raw/licence_flags/**/.gitkeep

# Rendered reports / misc outputs 
*.html
*.docx
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.gif
*.zip
*.tar.gz
*.rds
*.RData

# GBIF credentials
# Credentials are required to download from species with more than 100,000 entries.
# As such, a script is created containing my credentials, but these are not syned to GitHub. 
data/credentials.R

# Derived data products
data/processed/**

# Keep directory placeholders
!data/processed/**/
!data/processed/**/.gitkeep

# Quarto render artefacts
docs/*_files/
*.html

# Logs / scratch outputs
data/_logs/

# Meta data (ignore heavy external data)
data/_meta/**/*.csv
data/_meta/**/*.CSV
data/_meta/**/*.xlsx

# Stage logs (wrapper / audit / top-up)
data/_meta/logs/

# InfluentialSpecies: derived status-table outputs (ignore generated CSVs)
docs/derived/**
!docs/derived/**/
!docs/derived/**/.gitkeep
# Scratch / write tests
write-test*
# Regularisation sweep outputs (if generated / heavy)
data/_regularisation_sweep/**
!data/_regularisation_sweep/**/
!data/_regularisation_sweep/**/.gitkeep
# Ensure canonical species list is tracked (override meta CSV ignore)
!data/_meta/species_list_binomial.csv
